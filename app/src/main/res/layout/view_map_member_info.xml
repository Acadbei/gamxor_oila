<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/map_info_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="190dp"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/map_info_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="10dp"
        android:paddingTop="5dp"
        android:paddingRight="10dp"
        android:paddingBottom="5dp"
        android:textColor="#0F4FD6"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/map_info_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#10213A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/map_info_relation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#425C7E"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/map_info_place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#10213A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/map_info_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#425C7E"
        android:textSize="13sp" />
</LinearLayout>
